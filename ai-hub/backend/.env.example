# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Qwen (通义千问) Configuration
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Zhipu (智谱) Configuration
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Pexels API (Image Search)
PEXELS_API_KEY=your-pexels-api-key

# Unsplash API (Image Search)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database
SQLITE_DB_PATH=./data/sqlite/app.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# File Storage
UPLOAD_DIR=./data/uploads
WORKSPACE_DIR=./data/workspace

# CORS Configuration (comma-separated domains, or * for all)
# IMPORTANT: In production, set specific domains instead of *
# Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
