# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek Configuration（默认推荐，支持 thinking mode 思考过程流式输出）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen (通义千问) Configuration
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Zhipu (智谱) Configuration
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Pexels API (Image Search)
PEXELS_API_KEY=your-pexels-api-key

# Unsplash API (Image Search)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# =============================================================================
# Application Settings
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# =============================================================================
# JWT Authentication
#   生产环境必须修改此密钥！
# =============================================================================
JWT_SECRET_KEY=ai-hub-secret-key-change-in-production

# =============================================================================
# MySQL Database (主数据存储 + LangGraph Checkpoint)
#   生产环境: 使用专用低权限用户，避免 root
# =============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_hub
MYSQL_PASSWORD=your-secure-password
MYSQL_DATABASE=ai_hub

# =============================================================================
# LangGraph Checkpoint 后端 (mysql / sqlite)
#   mysql: 生产推荐，多进程安全
#   sqlite: 单进程开发 / 回退模式
# =============================================================================
LANGGRAPH_CHECKPOINT_BACKEND=mysql

# =============================================================================
# MySQL 连接池调优
# =============================================================================
MYSQL_POOL_SIZE=10
MYSQL_POOL_RECYCLE=3600

# =============================================================================
# SQLite (回退选项，langgraph_checkpoint_backend=sqlite 时使用)
# =============================================================================
SQLITE_DB_PATH=./data/sqlite/app.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# File Storage
UPLOAD_DIR=./data/storage/attachments
WORKSPACE_DIR=./data/storage/workspace

# CORS Configuration (comma-separated domains, or * for all)
# IMPORTANT: In production, set specific domains instead of *
# Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# Default Admin Account (首次启动自动创建)
#   用户名: admin
#   密码:   admin123
#   警告: 生产环境首次登录后请立即修改密码！
# =============================================================================

# =============================================================================
# 序列调度（v1.4）
#   FREE_MODEL_IDS            强制视为免费的模型 id 列表（逗号分隔，如 ollama:qwen2.5:7b）
#                             优先级：FREE_MODEL_IDS > 模型表 tier 标注 > provider=ollama 兜底
#   SEQUENCE_MAX_PARALLEL_PAID 付费模型序列并行上限（默认 3）
#   离线演示：无需任何 API Key，选模型「演示模型」（mock:mock-demo 免费 / mock:mock-pro 付费）
# =============================================================================
# FREE_MODEL_IDS=
SEQUENCE_MAX_PARALLEL_PAID=3
